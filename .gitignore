# CatchUp AI - Git Ignore
# Prevents sensitive keys, logs, and dependencies from being committed

# Environment variables & secrets
.env
.env.local
*.env

# Dependencies (if Node or Python is used)
node_modules/
package-lock.json
__pycache__/
*.pyc
venv/
.venv/
env/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs and temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
