# CatchUp AI - Environment Variables Template
# Copy this file to .env and fill in your values if using a backend server or Cloud AI
# NOTE: Never commit your actual .env file or real API keys to GitHub!

# Optional Google Gemini API Key (for Cloud AI Summarization mode)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenAI API Key (alternative Cloud AI provider)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional Server Port (default: 8000)
PORT=8000

# AI Provider choice: "local" (default offline heuristic), "gemini", or "openai"
AI_PROVIDER=local
